{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "packages/tasknest-ts/**",
      "apps/docs/src/**",
      "apps/docs/next.config.mjs",
      "apps/docs/source.config.ts",
      "apps/docs/postcss.config.mjs",
      "!packages/tasknest-ts/dist",
      "!apps/docs/.next",
      "!apps/docs/.source",
      "!apps/docs/out",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["..", "../*", "../**", "./../*", "./../**", "~/*", "#*"],
                "message": "Use @/, @<pkg-name>, or ./ imports instead of parent (../) or non-@ aliases."
              }
            ]
          }
        }
      }
    }
  }
}
