{
  "version": 1,
  "scenarios": [
    {
      "id": "discovery-nested-and-ignored",
      "tasks": [
        {
          "path": "check/dev",
          "name": "dev",
          "description": "Run dev checks.",
          "prints": ["DEV_RAN"]
        },
        {
          "path": "lint",
          "name": "lint",
          "description": "Lint project.",
          "depends": ["check.dev"],
          "prints": ["LINT_RAN"]
        }
      ],
      "extraFiles": {
        "tools/_helper": "helper_stub",
        "tools/tests/ignored_test": "test_stub",
        "tools/features/ignored.feature": "Feature: ignored\n"
      },
      "invocations": [
        {
          "args": ["ls"],
          "expectExitCode": 0,
          "expectStdoutContains": ["check dev (check.dev)", "lint (lint)"],
          "expectStdoutNotContains": ["_helper", "ignored_test"]
        },
        {
          "args": ["run", "lint"],
          "expectExitCode": 0,
          "expectStdoutContains": ["DEV_RAN", "LINT_RAN"]
        }
      ]
    },
    {
      "id": "cli-longest-prefix-and-disambiguation",
      "tasks": [
        {
          "path": "a",
          "name": "a",
          "description": "Parent task.",
          "options": [
            { "name": "arg", "type": "string", "default": "default" }
          ],
          "prints": ["A:{{arg}}"]
        },
        {
          "path": "a/b",
          "name": "b",
          "description": "Child task.",
          "prints": ["CHILD_B"]
        }
      ],
      "invocations": [
        {
          "args": ["run", "a", "b"],
          "expectExitCode": 0,
          "expectStdoutContains": ["CHILD_B"]
        },
        {
          "args": ["run", "a", "--", "b"],
          "expectExitCode": 0,
          "expectStdoutContains": ["A:b"],
          "expectStdoutNotContains": ["CHILD_B"]
        }
      ]
    },
    {
      "id": "cli-typed-options",
      "tasks": [
        {
          "path": "greet",
          "name": "greet",
          "description": "Typed greet task.",
          "options": [
            { "name": "count", "type": "int", "default": 1 },
            { "name": "dry_run", "type": "boolean", "default": false },
            { "name": "mode", "type": "string", "choices": ["fast", "full"], "default": "fast" }
          ],
          "prints": ["GREET:{{count}}:{{dry_run}}:{{mode}}"]
        }
      ],
      "invocations": [
        {
          "args": ["run", "greet", "--count", "3", "--dry-run", "--mode=full"],
          "expectExitCode": 0,
          "expectStdoutContains": ["GREET:3:true:full"]
        },
        {
          "args": ["run", "greet", "--count", "not-an-int"],
          "expectExitCode": 2
        },
        {
          "args": ["run", "greet", "--mode", "invalid"],
          "expectExitCode": 2
        }
      ]
    },
    {
      "id": "graph-diamond-and-failure-blocking",
      "tasks": [
        {
          "path": "base",
          "name": "base",
          "description": "Shared base.",
          "prints": ["BASE_ONCE"]
        },
        {
          "path": "left",
          "name": "left",
          "description": "Left branch.",
          "depends": ["base"],
          "prints": ["LEFT_OK"]
        },
        {
          "path": "right",
          "name": "right",
          "description": "Right failing branch.",
          "depends": ["base"],
          "failMessage": "right failed"
        },
        {
          "path": "top",
          "name": "top",
          "description": "Top target.",
          "depends": ["left", "right"],
          "prints": ["TOP_SHOULD_NOT_RUN"]
        }
      ],
      "invocations": [
        {
          "args": ["run", "top"],
          "expectExitCode": 1,
          "expectStdoutContains": ["BASE_ONCE", "LEFT_OK"],
          "expectStdoutNotContains": ["TOP_SHOULD_NOT_RUN"],
          "expectStderrContains": ["right", "top"]
        }
      ]
    },
    {
      "id": "graph-cycle-detection",
      "tasks": [
        {
          "path": "x",
          "name": "x",
          "description": "Task X.",
          "depends": ["y"]
        },
        {
          "path": "y",
          "name": "y",
          "description": "Task Y.",
          "depends": ["x"]
        }
      ],
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 2,
          "expectStderrContains": ["cycle"]
        }
      ]
    },
    {
      "id": "validation-unknown-mark-and-mark-filtering",
      "config": "[tasknest]\nconfig_version = 1\n\n[checks]\nstrict = true\nrequire_description = true\nunknown_marks = \"error\"\n\n[marks]\nfast = \"Fast task\"\nwrites = \"Modifies files\"\n",
      "tasks": [
        {
          "path": "prep",
          "name": "prep",
          "description": "Unmarked prerequisite.",
          "prints": ["PREP_RAN"]
        },
        {
          "path": "fmt",
          "name": "fmt",
          "description": "Format files.",
          "depends": ["prep"],
          "marks": ["fast", "writes"],
          "prints": ["FMT_RAN"]
        },
        {
          "path": "slow",
          "name": "slow",
          "description": "Slow task.",
          "prints": ["SLOW_RAN"]
        }
      ],
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 0
        },
        {
          "args": ["ls", "--mark", "fast"],
          "expectExitCode": 0,
          "expectStdoutContains": ["fmt (fmt)", "[marks: fast, writes]"],
          "expectStdoutNotContains": ["slow (slow)"]
        },
        {
          "args": ["run", "--mark", "fast"],
          "expectExitCode": 0,
          "expectStdoutContains": ["effect: fmt: marks=fast,writes", "PREP_RAN", "FMT_RAN"],
          "expectStdoutNotContains": ["SLOW_RAN"]
        }
      ]
    },
    {
      "id": "validation-strict-rejects-unknown-mark",
      "config": "[tasknest]\nconfig_version = 1\n\n[checks]\nstrict = true\nunknown_marks = \"error\"\n\n[marks]\nfast = \"Fast task\"\n",
      "tasks": [
        {
          "path": "bad",
          "name": "bad",
          "description": "Uses undeclared mark.",
          "marks": ["mystery"]
        }
      ],
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 2,
          "expectStderrContains": ["mystery"]
        }
      ]
    },
    {
      "id": "skill-drift-and-manual-overwrite-protection",
      "requiresJinja": true,
      "config": "[tasknest]\nconfig_version = 1\n\n[skill]\noutput = \"SKILL.md\"\ncommand = \"tasknest\"\n",
      "tasks": [
        {
          "path": "lint",
          "name": "lint",
          "description": "Lint workspace.",
          "marks": ["fast"]
        }
      ],
      "extraFiles": {
        "SKILL.md": "# Hand-written skill\nDo not clobber.\n"
      },
      "invocations": [
        {
          "args": ["skill", "--check"],
          "expectExitCode": 1,
          "expectStderrContains": ["DRIFT"]
        },
        {
          "args": ["skill", "--write"],
          "expectExitCode": 1,
          "expectStderrContains": ["--force"]
        },
        {
          "args": ["skill", "--write", "--force"],
          "expectExitCode": 0,
          "expectStdoutContains": ["WROTE"]
        },
        {
          "args": ["skill", "--check"],
          "expectExitCode": 0,
          "expectStdoutContains": ["OK"]
        }
      ]
    },
    {
      "id": "data-passing-output-and-deps",
      "tasks": [
        {
          "path": "produce",
          "name": "produce",
          "description": "Produce JSON payload.",
          "outputValue": { "greeting": "hello", "count": 2 }
        },
        {
          "path": "consume",
          "name": "consume",
          "description": "Consume producer output.",
          "depends": ["produce"],
          "readDep": "produce"
        }
      ],
      "invocations": [
        {
          "args": ["run", "consume"],
          "expectExitCode": 0,
          "expectStdoutContains": ["DEP:produce:hello:2"]
        }
      ]
    },
    {
      "id": "cache-hit-and-missing-output-invalidation",
      "extraFiles": {
        "src/in.txt": "seed-v1\n"
      },
      "tasks": [
        {
          "path": "build",
          "name": "build",
          "description": "Cached build.",
          "cache": true,
          "inputs": ["src/in.txt"],
          "outputs": ["dist/out.txt"],
          "writeFile": { "path": "dist/out.txt", "content": "artifact-v1\n" },
          "prints": ["BUILD_RAN"]
        }
      ],
      "invocations": [
        {
          "args": ["run", "--json", "build"],
          "expectExitCode": 0,
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskCacheStatus": { "build": "miss" }
          }
        },
        {
          "args": ["run", "--json", "build"],
          "expectExitCode": 0,
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskCacheStatus": { "build": "hit" }
          }
        },
        {
          "deleteFile": "dist/out.txt",
          "args": ["run", "--json", "build"],
          "expectExitCode": 0,
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskCacheStatus": { "build": "miss" }
          }
        },
        {
          "args": ["run", "--json", "--force", "build"],
          "expectExitCode": 0,
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskCacheStatus": { "build": "bypassed" }
          }
        }
      ]
    },
    {
      "id": "json-report-pure-stdout",
      "tasks": [
        {
          "path": "noisy",
          "name": "noisy",
          "description": "Prints noisy text.",
          "prints": ["NOISY_STDOUT"]
        }
      ],
      "invocations": [
        {
          "args": ["run", "--json", "noisy"],
          "expectExitCode": 0,
          "expectStdoutNotContains": ["NOISY_STDOUT"],
          "expectStderrContains": ["NOISY_STDOUT"],
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskStatus": { "noisy": "passed" }
          }
        }
      ]
    },
    {
      "id": "persistent-dependency-rejected",
      "tasks": [
        {
          "path": "dev_server",
          "name": "dev_server",
          "description": "Long-running dev server.",
          "persistent": true
        },
        {
          "path": "after",
          "name": "after",
          "description": "Invalid downstream task.",
          "depends": ["dev_server"]
        }
      ],
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 2,
          "expectStderrContains": ["cannot depend on persistent task"]
        }
      ]
    },
    {
      "id": "persistent-cache-rejected",
      "tasks": [
        {
          "path": "bad_dev",
          "name": "bad_dev",
          "description": "Invalid cached persistent task.",
          "persistent": true,
          "cache": true
        }
      ],
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 2,
          "expectStderrContains": ["cannot enable cache"]
        }
      ]
    },
    {
      "id": "persistent-mark-plan-and-run",
      "config": "[tasknest]\nconfig_version = 1\n\n[[discovery.roots]]\npath = \"tools\"\n\n[marks]\ndev = \"Development task\"\n\n[checks]\nstrict = true\nrequire_description = true\nunknown_marks = \"error\"\n",
      "tasks": [
        {
          "path": "build",
          "name": "build",
          "description": "One-shot build.",
          "prints": ["BUILT"]
        },
        {
          "path": "dev_a",
          "name": "dev_a",
          "description": "Dev service A.",
          "depends": ["build"],
          "marks": ["dev"],
          "persistent": true,
          "prints": ["DEV_A_READY"]
        },
        {
          "path": "dev_b",
          "name": "dev_b",
          "description": "Dev service B.",
          "depends": ["build"],
          "marks": ["dev"],
          "persistent": true,
          "prints": ["DEV_B_READY"]
        }
      ],
      "invocations": [
        {
          "args": ["plan", "--mark", "dev"],
          "expectExitCode": 0,
          "expectStdoutContains": ["build", "dev_a", "dev_b", "persistent=true"]
        },
        {
          "args": ["run", "--jobs", "1", "--mark", "dev"],
          "expectExitCode": 2,
          "expectStderrContains": ["persistent tasks concurrently"]
        },
        {
          "args": ["run", "--json", "--mark", "dev"],
          "expectExitCode": 0,
          "expectJson": {
            "schema_version": 1,
            "status": "passed",
            "taskStatus": { "build": "passed", "dev_a": "passed", "dev_b": "passed" }
          }
        }
      ]
    },
    {
      "id": "manifest-package-json-and-tier2-override",
      "config": "[tasknest]\nconfig_version = 1\n\n[[discovery.roots]]\npath = \"tools\"\n\n[discovery]\nworkspaces = true\n\n[checks]\nstrict = true\nrequire_description = true\nunknown_marks = \"error\"\n\n[marks]\nfast = \"Fast task\"\n",
      "tasks": [
        {
          "path": "web/build",
          "name": "build",
          "description": "Tier-2 web build override.",
          "prints": ["TIER2_WEB_BUILD"]
        }
      ],
      "extraFiles": {
        "package.json": "{\"name\": \"mono\", \"workspaces\": [\"apps/*\"]}",
        "bun.lock": "",
        "apps/web/package.json": "{\"scripts\": {\"build\": \"echo WEB_MANIFEST_BUILD\", \"lint\": \"echo WEB_LINT\"}, \"tasknest\": {\"tasks\": {\"lint\": {\"cmd\": [\"echo\", \"WEB_LINT\"], \"marks\": [\"fast\"], \"depends\": [\"build\"]}}}}",
        "apps/api/package.json": "{\"scripts\": {\"build\": \"echo API_BUILD\", \"lint\": \"echo API_LINT\"}, \"tasknest\": {\"tasks\": {\"lint\": {\"cmd\": [\"echo\", \"API_LINT\"], \"marks\": [\"fast\"]}}}}"
      },
      "invocations": [
        {
          "args": ["check"],
          "expectExitCode": 0
        },
        {
          "args": ["ls", "-p", "web"],
          "expectExitCode": 0,
          "expectStdoutContains": ["web build (web.build)", "web lint (web.lint)"],
          "expectStdoutNotContains": ["api lint"]
        },
        {
          "args": ["plan", "--each", "lint"],
          "expectExitCode": 0,
          "expectStdoutContains": ["web.build", "web.lint", "api.lint"]
        },
        {
          "args": ["plan", "-p", "api", "--each", "lint"],
          "expectExitCode": 0,
          "expectStdoutContains": ["api.lint"],
          "expectStdoutNotContains": ["web.lint"]
        },
        {
          "args": ["run", "-p", "web", "lint"],
          "expectExitCode": 0,
          "expectStdoutContains": ["TIER2_WEB_BUILD", "WEB_LINT"],
          "expectStdoutNotContains": ["WEB_MANIFEST_BUILD"]
        }
      ]
    },
    {
      "id": "manifest-pyproject-and-package-flag",
      "config": "[tasknest]\nconfig_version = 1\n\n[[discovery.manifests]]\npath = \"services/*\"\n\n[marks]\nci = \"CI task\"\n",
      "extraFiles": {
        "services/auth/pyproject.toml": "[tool.tasknest.tasks]\ntest = { cmd = [\"echo\", \"AUTH_TEST\"], marks = [\"ci\"] }\n",
        "services/billing/pyproject.toml": "[tool.tasknest.tasks]\ntest = { cmd = [\"echo\", \"BILLING_TEST\"], marks = [\"ci\"] }\n"
      },
      "invocations": [
        {
          "args": ["run", "--each", "test"],
          "expectExitCode": 0,
          "expectStdoutContains": ["AUTH_TEST", "BILLING_TEST"]
        },
        {
          "args": ["run", "-p", "auth", "--mark", "ci"],
          "expectExitCode": 0,
          "expectStdoutContains": ["AUTH_TEST"],
          "expectStdoutNotContains": ["BILLING_TEST"]
        }
      ]
    }
  ]
}
