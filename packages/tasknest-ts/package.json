{
  "name": "@archont561/tasknest",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Native TypeScript task runner scaffold",
  "homepage": "https://github.com/Archont561/tasknest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archont561/tasknest.git",
    "directory": "packages/tasknest-ts"
  },
  "bugs": {
    "url": "https://github.com/Archont561/tasknest/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tasknest": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bunup --watch",
    "build": "bunup",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "@huggingface/jinja": "^0.5.13"
  },
  "peerDependenciesMeta": {
    "@huggingface/jinja": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "^0.2.0",
    "@archont561/bun-test-utils": "0.2.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@huggingface/jinja": "0.5.13",
    "bunup": "0.16.32",
    "fast-check": "^4.10.2",
    "publint": "0.3.25"
  }
}
